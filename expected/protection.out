-- The drop refusals find the record table by its name in the extension's
-- schema, so while it holds records it cannot be renamed or moved out of
-- that schema: DROP EXTENSION would then drop it unrecognized.
CREATE SCHEMA pr_m;
ALTER TABLE repack_safe.rewrites RENAME TO pr_renamed;
ERROR:  cannot rename or move the pg_repack_safe record table while it holds records
DETAIL:  The extension finds its record table by the name "rewrites" in its own schema. Under another name or in another schema the table could be dropped with its records, and a snapshot taken before a recorded REPACK (CONCURRENTLY), on this server or on any standby, would then read the rewritten table as empty.
HINT:  Delete the records with repack_safe.prune_records() and run VACUUM on the record table until it is empty (see the README, "Removing the extension"). A superuser can set pg_repack_safe.allow_unprotected_removal instead.
ALTER TABLE repack_safe.rewrites SET SCHEMA pr_m;
ERROR:  cannot rename or move the pg_repack_safe record table while it holds records
DETAIL:  The extension finds its record table by the name "rewrites" in its own schema. Under another name or in another schema the table could be dropped with its records, and a snapshot taken before a recorded REPACK (CONCURRENTLY), on this server or on any standby, would then read the rewritten table as empty.
HINT:  Delete the records with repack_safe.prune_records() and run VACUUM on the record table until it is empty (see the README, "Removing the extension"). A superuser can set pg_repack_safe.allow_unprotected_removal instead.
-- The extension's schema is fixed (pg_repack_safe.control): PostgreSQL
-- refuses to move the extension, with its record table or after the table
-- was detached from it.
ALTER EXTENSION pg_repack_safe SET SCHEMA pr_m;
ERROR:  extension "pg_repack_safe" does not support SET SCHEMA
ALTER EXTENSION pg_repack_safe DROP TABLE repack_safe.rewrites;
ALTER EXTENSION pg_repack_safe SET SCHEMA pr_m;
ERROR:  extension "pg_repack_safe" does not support SET SCHEMA
ALTER EXTENSION pg_repack_safe ADD TABLE repack_safe.rewrites;
DROP SCHEMA pr_m;
