-- The override is for superusers only.
CREATE ROLE pr_user;
SET ROLE pr_user;
SET pg_repack_safe.allow_unprotected_drop = on;
ERROR:  permission denied to set parameter "pg_repack_safe.allow_unprotected_drop"
