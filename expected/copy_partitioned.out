21,row 21,5.2500000000000000
COPY public.cp TO STDOUT WITH (FORMAT csv, FORCE_QUOTE (a), NULL 'none');
8,"row 8",2.0000000000000000
9,"row 9",2.2500000000000000
10,"row 10",2.5000000000000000
11,"row 11",2.7500000000000000
