{
  "//": [
    "Multi-root workspace: this repo (read/write) + the PostgreSQL 19 source (read-only).",
    "",
    "Open with File > Open Workspace from File, not Open Folder (Open Folder",
    "drops the PG source folder).",
    "",
    "The second folder is /opt/pg19/src, the PG19 tree built into /opt/pg19/build",
    "and installed into /opt/pg19/install. files.readonlyInclude blocks accidental",
    "edits to it at the editor level. If your PG19 lives elsewhere, copy this file",
    "outside the repo and edit the /opt/pg19 paths there; do not commit",
    "per-developer paths.",
    "",
    "IntelliSense: files under the PG source resolve through the meson",
    "compile_commands.json; this repo's files are not in it and fall back to the",
    "PG19 installed server headers in includePath."
  ],
  "folders": [
    {
      "path": ".",
      "name": "pg_repack_safe (read/write)"
    },
    {
      "path": "/opt/pg19/src",
      "name": "PG19 Source (read-only)"
    }
  ],
  "settings": {
    "files.readonlyInclude": {
      "/opt/pg19/src/**": true
    },
    "files.readonlyFromPermissions": false,
    "search.exclude": {
      "/opt/pg19/build/**": true,
      "**/results/**": true,
      "**/output_iso/**": true
    },
    "C_Cpp.default.compileCommands": "/opt/pg19/build/compile_commands.json",
    "C_Cpp.default.includePath": [
      "/opt/pg19/install/include/postgresql/server",
      "/opt/pg19/install/include",
      "${workspaceFolder:pg_repack_safe (read/write)}/**"
    ],
    "C_Cpp.default.defines": [],
    "C_Cpp.default.compilerPath": "/usr/bin/gcc",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.errorSquiggles": "enabled",
    "[c]": {
      "editor.tabSize": 4,
      "editor.insertSpaces": true
    },
    "files.trimTrailingWhitespace": true,
    "github.copilot.chat.instructionsFiles": [
      "${workspaceFolder:pg_repack_safe (read/write)}/AGENTS.md"
    ]
  }
}
