# pg_repack_safe extension
comment = 'Stops PostgreSQL 19''s REPACK (CONCURRENTLY) from making a table look empty to transactions already running: they get an error instead. In force only where SELECT repack_safe.status() returns true. SELECT * FROM pg_get_loaded_modules() shows the library version'
default_version = '1.0'
module_pathname = '$libdir/pg_repack_safe'
relocatable = false
schema = repack_safe
superuser = true
trusted = false
# The install script checks the owner of the schema in PL/pgSQL.
requires = 'plpgsql'
