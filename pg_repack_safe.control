# pg_repack_safe extension
comment = 'Makes the built-in REPACK (CONCURRENTLY) safe: old snapshots get an error instead of wrong rows. In force only where SELECT repack_safe.status() returns true. SELECT * FROM pg_get_loaded_modules() shows the library version'
default_version = '1.0'
module_pathname = '$libdir/pg_repack_safe'
relocatable = false
schema = repack_safe
superuser = true
trusted = false
